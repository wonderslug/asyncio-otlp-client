{
  "name": "asyncio-otlp-client",
  "context": "..",
  "dockerFile": "../Dockerfile.dev",
  "runArgs": ["-e", "GIT_EDITOR=code --wait"],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "UV_LINK_MODE": "copy"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=${localEnv:HOME}/.claude.json,type=bind"
  ],
  // The default bind mount of the local repo folder rides on the host's
  // "fakeowner" FUSE shim, which rejects git's O_CREAT|O_EXCL object-write
  // pattern (`insufficient permission for adding an object to repository
  // database`). A named volume avoids that shim entirely. The volume
  // starts empty, so onCreateCommand below clones the repo into it.
  "workspaceMount": "source=asyncio-otlp-client-workspace,target=/workspaces/asyncio-otlp-client,type=volume",
  "workspaceFolder": "/workspaces/asyncio-otlp-client",
  "onCreateCommand": "test -d /workspaces/asyncio-otlp-client/.git || git clone git@github.com:wonderslug/asyncio-otlp-client.git /workspaces/asyncio-otlp-client",
  // The image cannot pre-seed the venv: /workspaces is overlaid by the empty
  // named volume above, so the sync has to happen after onCreateCommand's clone.
  "postCreateCommand": "make dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "visualstudioexptteam.vscodeintellicode",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/asyncio-otlp-client/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["--no-cov"],
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
